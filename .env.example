# Copy this file to .env and fill in your own Supabase connection string.
# Find it in your Supabase project: Project Settings -> Database -> Connection string -> URI.
# Use the "Connection pooling" URI (port 6543) if running from a scheduled/serverless
# context like GitHub Actions; use the direct connection (port 5432) for local dev.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:6543/postgres
